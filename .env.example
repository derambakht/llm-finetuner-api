# LLM Fine-Tuner API - Environment Variables
# Copy this file to .env and modify as needed

# ===========================================
# Application Settings
# ===========================================
APP_NAME=LLM Fine-Tuner API
APP_VERSION=1.0.0
DEBUG=false

# ===========================================
# Security
# ===========================================
# Comma-separated list of valid API keys
# Generate secure keys for production!
API_KEYS=your-secure-api-key-here,another-api-key

# ===========================================
# Hugging Face
# ===========================================
# Your Hugging Face access token (for private models and pushing to Hub)
# Get it from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Cache directory for downloaded models
HF_CACHE_DIR=./hf_cache

# ===========================================
# Storage
# ===========================================
# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./data/finetuner.db

# Maximum upload size in GB
MAX_UPLOAD_SIZE_GB=10.0

# ===========================================
# Fine-tuning Defaults
# ===========================================
DEFAULT_LEARNING_RATE=0.0002
DEFAULT_BATCH_SIZE=4
DEFAULT_EPOCHS=3
DEFAULT_MAX_SEQ_LENGTH=2048
DEFAULT_LORA_RANK=16
DEFAULT_LORA_ALPHA=32
DEFAULT_LORA_DROPOUT=0.05

# ===========================================
# Model Cache
# ===========================================
# TTL for supported models cache (seconds)
MODELS_CACHE_TTL=3600
