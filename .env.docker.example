# LLM Fine-Tuner API Environment Variables (Docker)
# Copy this file to .env and update the values

# Debug mode (true/false)
DEBUG=false

# API Keys (comma-separated for multiple keys)
API_KEYS=your-secure-api-key-here

# Hugging Face Token (required for gated models like Llama)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Database URL
DATABASE_URL=sqlite:///./data/finetuner.db

# Cache directory for Hugging Face models
HF_CACHE_DIR=/app/hf_cache
